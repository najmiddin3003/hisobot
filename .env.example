# Nusxa oling: .env.local — va qiymatlarni to'ldiring.
# Maxfiy kalitlarni yaratish: npm run gen:secret

# --- MongoDB (Atlas → Database → Connect → Drivers) ---
MONGODB_URI=
# Ixtiyoriy: baza nomi
MONGODB_DB=hisob-nazorat

# --- Xavfsizlik (bir marta yaratiladi, keyin o'zgartirmang) ---
# Seans cookie'larini imzolash uchun
AUTH_SECRET=
# Google Authenticator kalitlarini bazada shifrlash uchun (o'zgarsa, 2FA qayta ulanadi)
ENCRYPTION_KEY=

# --- Telegram bot (7-bosqich) ---
# @BotFather bergan token
TELEGRAM_BOT_TOKEN=
# Sizning Telegram ID'ingiz (@userinfobot) — bot faqat shu ID'ga javob beradi
TELEGRAM_ALLOWED_USER_ID=
# Webhook so'rovlarini tekshirish uchun
TELEGRAM_WEBHOOK_SECRET=

# --- AI yordamchi (8-bosqich) ---
ANTHROPIC_API_KEY=
# Ixtiyoriy: claude-sonnet-5-5 arzonroq
ANTHROPIC_MODEL=claude-opus-5-5

# --- Cron: eslatmalar va takroriy to'lovlar (10-bosqich) ---
CRON_SECRET=

# Saytning to'liq manzili
APP_URL=http://localhost:3000
